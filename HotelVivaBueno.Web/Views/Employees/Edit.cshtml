@model HotelVivaBueno.Data.Entities.Employee

@{
    ViewData["Title"] = "Editar Empleado";
}

<h1>Editar Empleado</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PasswordHash" /> 
            <!-- Keep existing password hash usually, or manage via separate change password flow -->

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="DocumentNumber" class="control-label">Documento</label>
                    <input asp-for="DocumentNumber" class="form-control" readonly />
                    <span asp-validation-for="DocumentNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="FirstName" class="control-label">Nombres</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="LastName" class="control-label">Apellidos</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
               <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="DateOfBirth" class="control-label">Fecha Nacimiento</label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="PhoneNumber" class="control-label">Celular</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Email" class="control-label">Correo</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                 <div class="col-md-6 form-group mb-3">
                    <label asp-for="Status" class="control-label">Estado</label>
                    <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<HotelVivaBueno.Data.Enums.EmployeeStatus>()"></select>
                     <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="JobTitle" class="control-label">Cargo</label>
                    <input asp-for="JobTitle" class="form-control" />
                    <span asp-validation-for="JobTitle" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="DepartmentId" class="control-label">Departamento</label>
                    <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments"></select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                 <div class="col-md-4 form-group mb-3">
                    <label asp-for="Salary" class="control-label">Salario</label>
                    <input asp-for="Salary" class="form-control" />
                    <span asp-validation-for="Salary" class="text-danger"></span>
                </div>
                <div class="col-md-4 form-group mb-3">
                    <label asp-for="HireDate" class="control-label">Fecha Ingreso</label>
                    <input asp-for="HireDate" class="form-control" type="date" />
                    <span asp-validation-for="HireDate" class="text-danger"></span>
                </div>
                 <div class="col-md-4 form-group mb-3">
                    <label asp-for="ContractType" class="control-label">Contrato</label>
                    <input asp-for="ContractType" class="form-control" />
                </div>
            </div>

             <div class="form-group mb-3">
                 <label asp-for="Shift" class="control-label">Turno</label>
                 <input asp-for="Shift" class="form-control" />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                 <button type="button" class="btn btn-danger float-end" onclick="confirmDelete(@Model.Id)">Eliminar</button>
            </div>
        </form>

        <form id="deleteForm" asp-action="Delete" method="post" style="display:none">
            <input type="hidden" name="id" id="deleteId" />
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function confirmDelete(id) {
            if (confirm('¿Estás seguro de que deseas eliminar este empleado?')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}
